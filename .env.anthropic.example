# === Anthropic configuration example ===
LLM_API_KEY= # Your Anthropic API key here
LLM_API_TYPE=anthropic
# claude-haiku-4-5, claude-sonnet-5, claude-opus-5-5, claude-fable-5-1
# see https://platform.claude.com/docs/en/about-claude/models/overview
MODEL=claude-sonnet-5

# Include model thinking (reasoning) wrapped in <think>...</think>
# in LLM responses and streamed output, default: false
# SHOW_THINKING=true

# If max_tokens is not set, Claude models get 64000 for streaming requests and 20000
# otherwise, or the model's output limit if it is lower. Thinking counts towards it.
# LLM_DEFAULT_ARGS={"max_tokens": 32000}

# It's required to install the `anthropic` package
# Run `pip install anthropic`
